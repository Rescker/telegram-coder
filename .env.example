# Copie deste arquivo para `.env` e preencha as duas primeiras chaves.
# (`.env` está no .gitignore — o token nunca vai para o git.)

# 1) Token do @BotFather (conversa com @BotFather -> /newbot).
#    Sem ele o bridge não sobe; com ele errado, falha com mensagem clara.
TELEGRAM_BOT_TOKEN=

# 2) Deixe 0 (ou vazio) na primeira execução. O bridge sobe em modo setup,
#    NÃO inicia o omp, e responde apenas /id para você descobrir o número.
#    Depois troque pelo id e rode de novo.
TELEGRAM_ALLOWED_USER_ID=0

# 3) Onde está o binário do omp. `omp` funciona se estiver no PATH.
OMP_BIN=omp

# 4) O projeto que o agente vai poder ler e editar.
#    Absoluto ou relativo (é resolvido). Aponte para uma pasta vazia no
#    primeiro teste; DEPOIS troque pelo projeto de verdade.
OMP_CWD=./sandbox

# write = edições de arquivo passam direto, bash pede aprovação por botão.
# (yolo = não pede nada; read = trava tudo em leitura.)
OMP_APPROVAL_MODE=write

# Vazio = usa o modelo que o omp já tem configurado.
OMP_MODEL=

STREAM_EDIT_SECONDS=2.0
MAX_MSG_CHARS=3800
DOC_THRESHOLD=12000
DATA_DIR=./data
